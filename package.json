{
  "name": "skyfree-3d",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "test:sim": "npm run build --workspace=server && node scripts/check-authoritative-sim.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
